// Prisma Schema untuk koneksi ke Neon PostgreSQL
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Book {
  id        Int      @id @default(autoincrement())
  judul     String
  penulis   String
  tahun     Int
  kategori  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

